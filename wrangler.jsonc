{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "secondrun-vault",
  "compatibility_date": "2026-09-14",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "d1_databases": [
    {
      "binding": "secondrun_vault",
      "database_name": "secondrun-vault",
      "database_id": "650976c0-14dc-4bc6-ab83-3f0dfa23a8b5"
    }
  ],
  "main": "vinext/server/fetch-handler",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "cache": {
    "enabled": true
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  }
}
