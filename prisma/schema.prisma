generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  passwordHash  String?
  image         String?
  role          String    @default("USER") // USER | PRO | ADMIN
  accounts      Account[]
  sessions      Session[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id               String    @id @default(cuid())
  slug             String    @unique
  name             String
  batch            String
  status           String    @default("INACTIVE") // INACTIVE | ACQUIRED | ACTIVE
  tagline          String
  industry         String
  location         String?
  foundedYear      Int?
  closedYear       Int?
  capitalBurned    String?   // e.g. "$3.2M"
  fatalFlawSummary String?   // 1-sentence failure takeaway
  logoUrl          String?
  ycUrl            String?
  websiteUrl       String?
  founders         Founder[]
  teardown         Teardown?
  createdAt        DateTime  @default(now())

  @@index([batch])
  @@index([industry])
  @@index([status])
}

model Founder {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  role        String?
  xUrl        String?
  linkedinUrl String?

  @@index([companyId])
}

model Teardown {
  id            String   @id @default(cuid())
  companyId     String   @unique
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  overview      String
  fatalFlaw     String?
  antiPatterns  String?  // JSON array: string[]
  sections      String   // JSON array: { title: string, body: string }[]
  rebuildThesis String?  // The strategic pivot model
  businessModel String?  // Zero-sales-team, unit economics
  agentPrompt   String?  // Massive Pocock to-spec / to-tickets prompt
  previewChars  Int      @default(3000)
  isPro         Boolean  @default(true)
  sources       String   // JSON array: string[]
}
